##########################################
# Local MQTT Broker Configuration
##########################################

# -----------------------------
# TCP Listener (CLI Testing)
# -----------------------------
listener 1883
protocol mqtt
allow_anonymous true  # set to false if you want username/password
# password_file /mosquitto/config/passwd  # only needed if allow_anonymous false

# -----------------------------
# WebSockets Listener (UI)
# -----------------------------
listener 9001
protocol websockets
socket_domain ipv4
#certfile /mosquitto/certs/mosquitto.crt
#keyfile /mosquitto/certs/mosquitto.key
allow_anonymous true  # set to false if you want username/password
# password_file /mosquitto/config/passwd  # only needed if allow_anonymous false

listener 9002
protocol websockets
socket_domain ipv4
allow_anonymous true

# -----------------------------
# Logging
# -----------------------------
# Write logs to container stdout/stderr so Docker json-file rotation limits size.
log_dest stdout

# Keep actionable logs and include connect/disconnect events for troubleshooting.
log_type notice
log_type error
log_type warning
log_type websockets

connection_messages true
log_timestamp true
websockets_log_level 255

# Reduce socket-level buffering delays while debugging websocket stability.
set_tcp_nodelay true

# -----------------------------
# Keepalive
# -----------------------------
# Allow clients to negotiate up to 60s keepalive interval.
# Prevents spurious timeout disconnects on brief network hiccups.
max_keepalive 60

# -----------------------------
# Persistence
# -----------------------------
persistence true
persistence_location /mosquitto/data/
